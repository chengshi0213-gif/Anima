    "interpretation": {
      "bazi": [
        {
          "title": "日主 · 癸（水）",
          "body": "雨露细流，感知力极强，情绪丰富，坚韧隐忍，需丙火温暖。这是你天生的底色。"
        },
        {
          "title": "月令取向 · 劫财",
          "body": "行动·争夺·讲义气；偏向资源/同辈的路子。（月令是八字的'格'，最能看你天然吃哪碗饭）"
        },
        {
          "title": "调候 · 寒暖燥湿",
          "body": "初春木气渐生，寒意未尽，仍喜火暖局。"
        },
        {
          "title": "五行取用 · 水",
          "body": "五行属水，行业上可往：贸易·物流·旅游·咨询·外语。"
        }
      ],
      "ziwei": [
        {
          "title": "命宫主星 · 武曲",
          "body": "武曲——财富·意志·刚毅·行动力。务实果断，重效率，意志力强，不善言辞；长处在执行力强，财务能力好，行动力强，要留意刚硬，不懂变通，感情上较理性。"
        },
        {
          "title": "命宫辅煞",
          "body": "右弼（贵人助力，增强主星正面特质）、陀罗（拖延·纠缠·暗耗，在命宫主事情拖拉）。"
        },
        {
          "title": "生年四化 · 落宫",
          "items": [
            "化禄（天梁）落「子女」：子女缘深·部属得力",
            "化权（紫微）落「官禄」：事业强势·有权位·掌控力强",
            "化科（左辅）落「迁移」：在外名声佳·贵人相助",
            "化忌（武曲）落「命宫」：个人运势受阻·多是非·需低调"
          ]
        },
        {
          "title": "事业主轴 · 命财官迁",
          "items": [
            "命宫（戌）：武曲",
            "财帛（午）：廉贞、天相",
            "官禄（寅）：紫微、天府",
            "迁移（辰）：贪狼"
          ]
        },
        {
          "title": "身宫 · 后天着力",
          "body": "身宫落「财帛」（午），主星廉贞、天相——中年后逐渐显化、是你后天用力的方向。"
        }
      ]
