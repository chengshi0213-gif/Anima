{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anima",
  "version": "1.1.0",
  "identifier": "com.anima.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "Anima",
        "theme": "Light",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "focus": true,
        "visible": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "id": "anima-tray",
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false,
      "tooltip": "Anima"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../backend/dist/anima-server"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2OUQ3QjcwNDU3NENBRDgKUldUWXluUkZjSHVkTmwzY3NxeUpxRTJ1bUliZ2JpdVcrY0NZUDJZUDZucjRoNE5MZmIrNVlvcmkK",
      "endpoints": [
        "https://chengshi0213-gif.github.io/anima-site/update.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "basicUi"
      }
    }
  }
}
